# Wayfinder wrote this file when it created this repository.
#
# It holds the two values the workflows cannot read from anywhere else: which
# stack this repository deploys, and which `wf` build CI installs. Everything
# else CI needs — the Wayfinder server, the service account each job signs in
# as, the environment it deploys to and the AWS region — is a GitHub variable
# Wayfinder set at the same time, and the per-environment ones are visible only
# to a job that declares that environment.

# Names the stack instances: <stack>-develop and <stack>-prod for the two
# long-lived deployments, and <stack>-pr<number> for the dry run a pull request
# does, which creates nothing.
WF_STACK_NAME=${{ .Stack.Name }}

# The `wf` CLI build CI installs. Empty tracks the latest development build;
# set it to a released version (e.g. v3.2.1) to pin.
WF_CLI_VERSION=
