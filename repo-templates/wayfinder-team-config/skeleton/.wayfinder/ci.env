# Wayfinder wrote this file when it created this repository.
#
# It holds the values that identify THIS repository to Wayfinder. Both CI jobs
# load it, so this is where to add a new per-repository value — the workflows
# themselves are copied verbatim from the template and carry no repository
# specifics.
#
# Values that differ per Wayfinder installation rather than per repository —
# the server URL, and the mailbox a vended account's root email is derived from
# — are GitHub repository or organisation variables instead. See the template
# README.

# The Wayfinder API this repository's CI talks to. Blank means the CLI's own
# default, which is the SaaS API. The WAYFINDER_SERVER GitHub variable overrides
# it, so an installation-wide value can be set in one place for every repository.
WF_SERVER=${{ .Inputs.wayfinderServer }}

# Identity
WF_TEAM=${{ .Inputs.team }}
WF_WORKSPACE=${{ .Inputs.workspace }}
WF_TENANT=${{ .Tenant }}

# The CLI authenticates as this implicitly. Fully qualified at run time as
# <tenant>:<workspace>:<name>.
WF_SERVICE_ACCOUNT_NAME=${{ .Inputs.serviceAccount }}

# `wf apply --prune` reaps only what this owner created, which is what makes
# deleting a manifest safe: it can never reach an object this repository did not
# make.
WF_OWNER=wayfinder-${{ .Inputs.team }}

# Where the vending workflow lives, and what it is called. The vend belongs to
# the platform team, never to this repository.
WF_PLATFORM_WORKSPACE=${{ .Inputs.platformWorkspace }}
WF_VEND_WORKFLOW=${{ .Inputs.vendWorkflow }}

# Tagged onto a vended account's spend. Blank means the vend is invoked without
# a cost code.
WF_COST_CODE=${{ .Inputs.costCode }}
